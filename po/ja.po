#: src/sekkaconfig.h
msgid "Dictionary path"
msgstr "辞書パス"

#: src/sekkaconfig.h
msgid "User dictionary path"
msgstr "ユーザー辞書パス"

#: src/sekkaconfig.h
msgid "Conversion key"
msgstr "変換キー"

#: src/sekkaconfig.h
msgid ""
"Leave empty to find sekka/master-dict.db automatically in the fcitx5 data "
"directories ($XDG_DATA_HOME/fcitx5 first, then the fcitx5 directories "
"under $XDG_DATA_DIRS). A path entered here is used as it is, without "
"searching."
msgstr "空欄にすると、fcitx5 のデータディレクトリ（まず $XDG_DATA_HOME/fcitx5、次に $XDG_DATA_DIRS 側の fcitx5 ディレクトリ）から sekka/master-dict.db を自動で探します。パスを入れると、探さずにそのパスだけを使います。"

#: src/sekkaconfig.h
msgid ""
"Leave empty to use the default location, sekka/user-dict.db in the fcitx5 "
"user data directory ($XDG_DATA_HOME/fcitx5, or ~/.local/share/fcitx5 when "
"XDG_DATA_HOME is not set)."
msgstr "空欄にすると既定の場所を使います。fcitx5 のユーザーデータディレクトリ（$XDG_DATA_HOME/fcitx5。XDG_DATA_HOME が未設定なら ~/.local/share/fcitx5）の sekka/user-dict.db です。"

#: src/sekka.cpp
msgid "Sekka: failed to load a dictionary"
msgstr "Sekka: 辞書を読み込めませんでした"

#: src/sekka.cpp
msgid ""
"refused to load the master dictionary for safety because its path is "
"writable (deploying it root-owned with mode 644 is recommended): "
msgstr ""
"マスター辞書パスが書き込み可能なため安全のためロードを拒否しました"
"（root所有・644での配置を推奨）: "

#: src/sekka.cpp
msgid "master dictionary not found: "
msgstr "マスター辞書が見つかりません: "

#: src/sekka.cpp
msgid "master dictionary not found in the search locations: "
msgstr "マスター辞書が探索場所に見つかりません: "

#: src/sekka.cpp
msgid "cannot open the master dictionary (check the permissions): "
msgstr "マスター辞書を開けません（権限を確認してください）: "

#: src/sekka.cpp
msgid "the master dictionary is corrupt (invalid format or version): "
msgstr "マスター辞書が壊れています（形式またはバージョンが不正）: "

#: src/sekka.cpp
msgid "failed to load the master dictionary: "
msgstr "マスター辞書のロードに失敗しました: "

#: src/sekka.cpp
msgid "failed to load the user dictionary: "
msgstr "ユーザー辞書のロードに失敗しました: "
