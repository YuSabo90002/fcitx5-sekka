#: src/sekkaconfig.h
msgid "Dictionary path"
msgstr "辞書パス"

#: src/sekkaconfig.h
msgid "User dictionary path"
msgstr "ユーザー辞書パス"

#: src/sekkaconfig.h
msgid "Conversion key"
msgstr "変換キー"

#: src/sekka.cpp
msgid "Sekka: failed to load a dictionary"
msgstr "Sekka: 辞書を読み込めませんでした"

#: src/sekka.cpp
msgid ""
"refused to load the master dictionary for safety because its path is "
"writable (deploying it root-owned with mode 644 is recommended): "
msgstr ""
"マスター辞書パスが書き込み可能なため安全のためロードを拒否しました"
"（root所有・644での配置を推奨）: "

#: src/sekka.cpp
msgid "master dictionary not found: "
msgstr "マスター辞書が見つかりません: "

#: src/sekka.cpp
msgid "cannot open the master dictionary (check the permissions): "
msgstr "マスター辞書を開けません（権限を確認してください）: "

#: src/sekka.cpp
msgid "the master dictionary is corrupt (invalid format or version): "
msgstr "マスター辞書が壊れています（形式またはバージョンが不正）: "

#: src/sekka.cpp
msgid "failed to load the master dictionary: "
msgstr "マスター辞書のロードに失敗しました: "

#: src/sekka.cpp
msgid "failed to load the user dictionary: "
msgstr "ユーザー辞書のロードに失敗しました: "
